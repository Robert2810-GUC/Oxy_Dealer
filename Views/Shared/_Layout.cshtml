<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Oxygen Solutions</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="os-body">

    <!-- Quote backdrop (outside panel so it doesn't darken the panel itself) -->
    <div class="quote-panel-backdrop" id="close-quote-backdrop"></div>

    <!-- Quote panel -->
    <div class="quote-panel" id="quote-panel">
        <div class="quote-panel-inner">
            <div class="quote-panel-header">
                <span class="font-serif">Quote list</span>
                <button id="close-quote" aria-label="Close">&#x2715;</button>
            </div>
            <div class="quote-panel-body" id="quote-panel-body"></div>
            <div class="quote-panel-footer">
                <div class="qp-footer-top">
                    <span class="qp-count font-mono" id="quote-panel-count">0 items in your quote</span>
                    <button id="clear-quote" class="qp-clear font-mono">Clear all</button>
                </div>
                <a asp-controller="Contact" asp-action="Quote" class="btn-solid qp-request">Request pricing</a>
            </div>
        </div>
    </div>

    <div class="os-shell">

        <!-- Sidebar (desktop) -->
        <aside class="os-sidebar">
            <a asp-controller="Home" asp-action="Index" class="os-logo">Oxygen <span>Solutions</span></a>

            <nav class="os-nav">
                <ul>
                    <li>
                        <a asp-controller="Home" asp-action="Why" data-nav="why">
                            <span class="nav-num">01</span> Why Oxygen Solutions?
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Home" asp-action="TheSystem" data-nav="system">
                            <span class="nav-num">02</span> The system
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Catalog" asp-action="Index" data-nav="os-catalog">
                            <span class="nav-num">03</span> Equipment
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Contact" asp-action="Index" data-nav="os-contact">
                            <span class="nav-num">04</span> Get in touch
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Contact" asp-action="FindInstaller" data-nav="find-installer">
                            <span class="nav-num">05</span> Find an installer
                        </a>
                    </li>
                </ul>
            </nav>

            <div class="os-sidebar-tagline">
                Oxygen enrichment systems for mountain homes &mdash; designed, installed and serviced by certified installers.
            </div>

            <div id="os-o2-widget" class="os-o2-widget">
                <div class="o2-label">Live network</div>
                <div class="o2-value-row">
                    <span id="o2-value">88.4</span>
                    <span class="o2-unit">% O&#x2082;</span>
                </div>
                <div class="o2-bar-wrap">
                    <div id="o2-bar" class="o2-bar" style="--pct:62%"></div>
                </div>
                <div class="o2-status">
                    <span id="o2-pulse" class="o2-pulse"></span>
                    Enriching &middot; 6,500 ft
                </div>
            </div>

            <div class="os-sidebar-cta">
                <button class="btn-quote-list" id="open-quote-panel">
                    Quote list <span class="quote-badge" id="quote-badge">0</span>
                </button>
                <a asp-controller="Contact" asp-action="Quote" class="btn-solid">Request a quote</a>
                <a href="#" class="btn-ghost btn-dealer-login">Dealer login</a>
            </div>
        </aside>

        <!-- Mobile header -->
        <header class="os-mobile-header">
            <button class="hamburger" id="mobile-menu-btn" aria-label="Open menu">
                <svg width="22" height="16" viewBox="0 0 22 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect y="0" width="22" height="2" rx="1" fill="currentColor"/>
                    <rect y="7" width="22" height="2" rx="1" fill="currentColor"/>
                    <rect y="14" width="22" height="2" rx="1" fill="currentColor"/>
                </svg>
            </button>
            <a asp-controller="Home" asp-action="Index" class="os-logo os-logo-mobile">Oxygen <span>Solutions</span></a>
            <button class="btn-quote-mobile" id="open-quote-panel-mobile">
                Quote <span class="quote-badge" id="quote-badge-mobile">0</span>
            </button>
            <nav class="os-mobile-nav" id="os-mobile-nav">
                <ul>
                    <li><a asp-controller="Home" asp-action="Why"><span class="nav-num">01</span> Why Oxygen Solutions?</a></li>
                    <li><a asp-controller="Home" asp-action="TheSystem"><span class="nav-num">02</span> The system</a></li>
                    <li><a asp-controller="Catalog" asp-action="Index"><span class="nav-num">03</span> Equipment</a></li>
                    <li><a asp-controller="Contact" asp-action="Index"><span class="nav-num">04</span> Get in touch</a></li>
                    <li><a asp-controller="Contact" asp-action="FindInstaller"><span class="nav-num">05</span> Find an installer</a></li>
                </ul>
                <div class="mobile-nav-cta">
                    <a asp-controller="Contact" asp-action="Quote" class="btn-solid">Request a quote</a>
                </div>
            </nav>
        </header>

        <!-- Main content -->
        <main class="os-main">
            @RenderBody()
            @await RenderSectionAsync("Scripts", required: false)
        </main>

    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
