@model OxygenSolutions.Models.GeneralInquiry
@{
    ViewData["Title"] = "Get in Touch";
}

<div class="os-page-header">
    <div class="os-section-eyebrow">04 &mdash; Get in touch</div>
    <h1 class="font-serif">How can we help?</h1>
    <p class="os-page-subhead">Send us a message and our team will get back to you shortly.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="os-alert os-alert-success">
        @TempData["Success"]
    </div>
}

<div class="os-contact-layout">
    <div class="os-contact-form-col">

        <div class="os-contact-section-label font-mono">Contact Information</div>

        <form asp-action="Index" method="post" class="os-form">
            <div asp-validation-summary="ModelOnly" class="os-validation-summary"></div>

            <div class="os-form-row">
                <div class="os-form-group">
                    <label asp-for="FirstName" class="font-mono">First Name <span class="required">*</span></label>
                    <input asp-for="FirstName" class="os-input" placeholder="Jane" />
                    <span asp-validation-for="FirstName" class="os-field-error"></span>
                </div>
                <div class="os-form-group">
                    <label asp-for="LastName" class="font-mono">Last Name <span class="required">*</span></label>
                    <input asp-for="LastName" class="os-input" placeholder="Smith" />
                    <span asp-validation-for="LastName" class="os-field-error"></span>
                </div>
            </div>

            <div class="os-form-group">
                <label asp-for="CompanyName" class="font-mono">Company Name</label>
                <input asp-for="CompanyName" class="os-input" placeholder="Acme HVAC" />
            </div>

            <div class="os-form-row">
                <div class="os-form-group">
                    <label asp-for="Email" class="font-mono">Email Address <span class="required">*</span></label>
                    <input asp-for="Email" class="os-input" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="os-field-error"></span>
                </div>
                <div class="os-form-group">
                    <label asp-for="Phone" class="font-mono">Phone Number</label>
                    <input asp-for="Phone" class="os-input" placeholder="(406) 555-0100" />
                </div>
            </div>

            <div class="os-contact-section-label font-mono" style="margin-top:8px">Inquiry</div>

            <div class="os-form-group">
                <label asp-for="Subject" class="font-mono">Subject / Reason for Contact <span class="required">*</span></label>
                <input asp-for="Subject" class="os-input" placeholder="e.g. Product question, installer referral, general info" />
                <span asp-validation-for="Subject" class="os-field-error"></span>
            </div>

            <div class="os-form-group">
                <label asp-for="Message" class="font-mono">Message / How Can We Help? <span class="required">*</span></label>
                <textarea asp-for="Message" class="os-textarea" rows="6" placeholder="Tell us what you need..."></textarea>
                <span asp-validation-for="Message" class="os-field-error"></span>
            </div>

            <button type="submit" class="btn-solid">Send Message</button>
        </form>
    </div>

    <div class="os-contact-info-col">
        <div class="os-contact-info-card">
            <h3 class="font-serif">Get in touch directly</h3>

            <div class="os-contact-item">
                <div class="os-contact-item-label font-mono">Email</div>
                <a href="mailto:jlausen@oxygen-solutions.net">jlausen@oxygen-solutions.net</a>
            </div>

            <div class="os-contact-item">
                <div class="os-contact-item-label font-mono">Phone</div>
                <a href="tel:4062094450">(406) 209-4450</a>
            </div>

            <div class="os-contact-item">
                <div class="os-contact-item-label font-mono">Markets served</div>
                <p>Colorado &middot; Montana &middot; Wyoming &middot; Idaho &middot; Utah</p>
            </div>

            <hr class="os-contact-divider" />

            <p class="os-contact-note">We respond to all messages within 1&ndash;2 business days.</p>

            <div style="display:flex;flex-direction:column;gap:10px;margin-top:20px">
                <a asp-controller="Contact" asp-action="FindInstaller" class="btn-outline-dark">Find a certified installer</a>
                <a asp-controller="Contact" asp-action="DesignService" class="btn-outline-dark">Request a design</a>
            </div>
        </div>
    </div>
</div>
